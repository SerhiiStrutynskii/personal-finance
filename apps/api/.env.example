NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/personal_finance
# Окрема база для тестів: таблиці в ній очищаються перед кожним тестом. Назва має закінчуватися на _test.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/personal_finance_test
CORS_ORIGIN=http://localhost:5173
# Секрет підпису access-токенів, щонайменше 32 символи: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# false закриває реєстрацію нових користувачів (для сервера, де акаунти вже створено)
REGISTRATION_ENABLED=true
# Каталог зі зібраним фронтендом; якщо задано, API роздає його з того самого домену (продакшн)
# WEB_DIST_DIR=../web/dist
# Кількість проксі перед застосунком (на хостингу зазвичай 1); локально 0
TRUST_PROXY=0
