NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/personal_finance
# Окрема база для тестів: таблиці в ній очищаються перед кожним тестом. Назва має закінчуватися на _test.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/personal_finance_test
CORS_ORIGIN=http://localhost:5173
# Користувач за замовчуванням, поки немає авторизації (створюється командою npm run db:seed)
DEV_USER_ID=00000000-0000-4000-8000-000000000001
