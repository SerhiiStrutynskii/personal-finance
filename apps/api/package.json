{
  "name": "@hf/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file=.env src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:migrate:prod": "tsx src/db/migrate.ts",
    "db:seed": "NODE_ENV=development tsx --env-file=.env src/db/seed.ts",
    "e2e:server": "tsx --env-file=.env src/test/e2e-server.ts"
  },
  "dependencies": {
    "@hf/shared": "*",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.2.0",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
