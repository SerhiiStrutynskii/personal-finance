# Налаштування продакшн-сервера для docker-compose.yml. Скопіюйте у .env на сервері:
#   cp .env.example .env
# Файл .env не потрапляє в репозиторій. Для локальної розробки — apps/api/.env.example.

# Домен, спрямований на сервер (A-запис). Для нього Caddy отримає HTTPS-сертифікат.
DOMAIN=finance.example.com

# Пароль бази: лише літери й цифри, бо він входить в адресу підключення.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Секрет підпису токенів, щонайменше 32 символи.
#   openssl rand -hex 48
JWT_SECRET=

# true — лише на час створення ваших акаунтів; потім поверніть false і перезапустіть застосунок.
REGISTRATION_ENABLED=false
